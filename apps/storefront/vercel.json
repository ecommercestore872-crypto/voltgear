{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": { "deploymentEnabled": { "codex/buyntry-meta-readiness-20261102": false } },
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @voltgear/storefront",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs storefront",
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/flows",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/warm-storefront",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/meta-purchase-outbox",
      "schedule": "*/30 * * * *"
    }
  ]
}

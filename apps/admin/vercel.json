{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": { "deploymentEnabled": { "codex/buyntry-meta-readiness-20261102": false } },
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @voltgear/admin",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs admin",
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/admin/warm",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/postex-sync",
      "schedule": "*/30 * * * *"
    }
  ]
}

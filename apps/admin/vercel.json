{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w @voltgear/admin",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs admin",
  "git": {
    "deploymentEnabled": {
      "codex/buyntry-tiktok-release-20261101": false
    }
  },
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/admin/warm",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/postex-sync",
      "schedule": "*/30 * * * *"
    }
  ]
}

{
  "name": "voltgear-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @voltgear/storefront",
    "dev:storefront": "npm run dev -w @voltgear/storefront -- -p 3000",
    "dev:admin": "npm run dev -w @voltgear/admin -- -p 3001",
    "build": "npm run build -w @voltgear/storefront && npm run build -w @voltgear/admin",
    "build:header-logo": "node scripts/build-header-logo.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "convert:blog-covers": "node scripts/convert-blog-covers-webp.mjs",
    "convert:category-cutouts": "node scripts/category-cutouts-to-webp.mjs",
    "seed:category-webp": "tsx scripts/sync-category-webp-urls.ts",
    "build:storefront": "npm run build -w @voltgear/storefront",
    "ci:storefront": "npm run test && npm run build:storefront",
    "ci": "npm run test && npm run lint && npm run build",
    "lint:admin": "npm run lint -w @voltgear/admin",
    "lint:all": "npm run lint -w @voltgear/storefront && npm run lint -w @voltgear/admin",
    "build:admin": "npm run build -w @voltgear/admin",
    "start": "npm run start -w @voltgear/storefront",
    "lint": "npm run lint:all",
    "test": "node scripts/run-unit-tests.mjs",
    "migrate:sanity": "tsx scripts/migrate-sanity-to-supabase.ts",
    "seed:blog": "tsx scripts/seed-blog-guides.ts",
    "ensure:admin-auth": "tsx scripts/ensure-admin-auth-user.ts",
    "indexnow": "tsx scripts/submit-indexnow.ts",
    "smoke:t40": "node scripts/smoke-t40-production.mjs",
    "postex:smoke": "node scripts/postex-smoke.mjs",
    "resend:health": "node scripts/resend-health.mjs",
    "resend:webhook-setup": "node scripts/setup-resend-webhook.mjs",
    "resend:backfill-suppressions": "node scripts/backfill-resend-suppressions.mjs",
    "audit:security": "tsx scripts/audit-security.ts",
    "export:dr": "tsx scripts/monthly-dr-export.ts",
    "verify:dr": "tsx scripts/verify-dr-export.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@portabletext/react": "^3.2.4",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/functions": "^2.2.13",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.1",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.26.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/selenium-webdriver": "^4.35.6",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "selenium-webdriver": "^4.48.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}

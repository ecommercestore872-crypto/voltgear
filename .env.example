# ── Supabase (database + auth) ────────────────────────────────────────
# LIVE + local: Final-store (zeuhfqevqjkbzwdaxjuv). Org: VoltGear Store.
# Dashboard: https://supabase.com/dashboard/project/zeuhfqevqjkbzwdaxjuv
# Do not use the paused project dvdiixgojsmautkehccl for this shop.
# Copy keys from Project Settings → API. Do not commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://zeuhfqevqjkbzwdaxjuv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Vercel (production deploy target) ─────────────────────────────────
# Team: ecommercestore872-crypto · Project: voltgear · Site: buyntryy.com
# Set env vars in Vercel dashboard or `vercel env pull`; not needed in .env.example values.

# Sanity: legacy migration only (npm run migrate:sanity). /studio → /admin. Optional locally.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Canonical URLs, sitemap.xml and robots.txt are built from this.
# Production must be the public shop domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://buyntryy.com

# Shop → admin routing (T-40). Staff URL: https://buyntryy.com/admin
# Same-origin (recommended): set on shop Vercel project only
# ADMIN_PUBLIC_URL=https://buyntryy.com
# ADMIN_PROXY_UPSTREAM=https://your-voltgear-admin.vercel.app
# On admin project: NEXT_PUBLIC_ADMIN_ASSET_ORIGIN=https://your-voltgear-admin.vercel.app
# Legacy redirect off-domain: ADMIN_PUBLIC_URL=https://your-voltgear-admin.vercel.app (no ADMIN_PROXY_UPSTREAM)
# ADMIN_API_SLOW_MS=800
# ADMIN_SUPABASE_SLOW_MS=600
# ADMIN_API_LOG_ALL=0

# Admin password for /admin/login and admin APIs. Required in production.
ADMIN_TOKEN=

# Supabase Auth emails allowed to use forgot-password (comma-separated). Default: alyabbas101@gmail.com
# ADMIN_AUTH_EMAILS=alyabbas101@gmail.com

# Read token — required only for preview drafts. Create in
# Sanity Manage → API → Tokens with "read" permission
SANITY_API_TOKEN=

# ── Cloudinary (image hosting + AI background removal) ────────────────
# Get credentials at https://cloudinary.com/console → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ecommerce-products
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Contact form notifications (optional) ─────────────────────────────
# If set, contact form submissions are posted to this webhook (e.g. Slack)
# SLACK_WEBHOOK_URL=

# ── Email automation (Resend) ─────────────────────────────────────────
# https://resend.com → API Keys. Without a key, emails are logged in dev.
RESEND_API_KEY=
# Resend webhook signing secret (admin app only). From Resend → Webhooks.
RESEND_WEBHOOK_SECRET=
# Verified sending address after you confirm the domain in Resend.
# Leave blank to use Buy n Try <onboarding@resend.dev> (test only).
# Live shop: Buy n Try <noreply@mail.buyntryy.com>
FROM_EMAIL="Buy n Try <noreply@mail.buyntryy.com>"
# Inbox that gets a BCC of new order confirmations (and Reply-To). Not used for status emails.
ORDER_NOTIFY_EMAIL=
# Shown as the brand name in email templates
BRAND_NAME=Buy n Try

# ── Analytics ─────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID (optional). Live shop only — never localhost or /admin.
NEXT_PUBLIC_CLARITY_ID=
# TikTok Pixel (Events Manager base code). Public ID; enable only on production.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DAF1KQBC77UES974M180
NEXT_PUBLIC_TIKTOK_PIXEL_ENABLED=false

# Google AdSense publisher ID for buyntryy.com (public; also in page <head>).
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-1159111109427878
# Optional Display ad unit ID for blog guides only. Leave blank until you create
# a unit in AdSense. Keep Auto ads OFF so banners never appear on shop/checkout.
NEXT_PUBLIC_ADSENSE_BLOG_SLOT=

# ── Schedule email flows (pick one) ───────────────────────────────────
# Every run of /api/flows sends due emails and re-checks for win-back
# candidates (customers with no order in the last 90 days).
#
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to GET /api/flows.
# Required in production. Hobby plan: once per day (see vercel.json).
CRON_SECRET=
#
# Or any external scheduler (GitHub Actions, cron job, UptimeRobot):
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://yourdomain.com/api/flows

NEXT_PUBLIC_META_PIXEL_ID=
